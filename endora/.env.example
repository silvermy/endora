# Copy this file to .env and fill in your values.
# .env is never committed to git.

# RTSP stream URLs for your two cameras
RTSP_URL_A=rtsp://admin:password@192.168.1.100:554/stream1
RTSP_URL_B=rtsp://admin:password@192.168.1.101:554/stream1

# Long-Lived Access Token from HA Profile page
HA_TOKEN=your_long_lived_token_here

# HA API URL — use localhost if endora runs on the same machine as HA
# Use the HA machine's IP if they're on different hosts
HA_URL=http://localhost:8123/api

# debug | info | warning | error
LOG_LEVEL=info

# ── Jetson (docker-compose.jetson.yml) only ──────────────────────────────
# auto | tensorrt | cuda | cpu. "auto" picks the GPU when one is available.
YOLO_EXECUTION_PROVIDER=auto

# Debug web UI port. Unlike the add-on there is no Configuration tab and no
# sidebar entry, so this is how you reach it: http://<this-host-ip>:8765/
# 0 disables it.
DEBUG_PORT=8765

# Record real keypoint traces for regression tests (0 = off).
# With this on, each fired gesture writes a .npz of the preceding seconds of
# raw keypoints to /data/test_captures, and the debug page grows a "Capture
# test case" button for poses that do not fire. Replay them through the real
# pipeline in tests — see tests/test_captured.py.
ENDORA_RECORD_TESTS=0
